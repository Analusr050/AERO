# Banco de dados PostgreSQL utilizado pelo Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aero_dev?schema=public"

# Token de verificação do webhook (handshake da Meta)
VERIFY_TOKEN="meu_token_secreto"

# Credenciais da WhatsApp Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Quando true (ou quando token/phone id estiverem vazios), os envios são simulados
WHATSAPP_MOCK="true"

# Link enviado ao cliente na saudação
LINK_CARDAPIO="https://exemplo.com/cardapio"

# Telefone que recebe a notificação de novo pedido
TELEFONE_PROPRIETARIO="5511999999999"
